<?xml version="1.0" encoding="utf-8"?>
<!-- The JVM arguments dialog: a list of arguments that can be added, edited, deleted and turned on or off -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/jvm_args_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="One argument in each row. Turn the box off to keep an argument without using it. Changes apply the next time the game starts."
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/jvm_args_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/jvm_args_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="No arguments yet."
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/jvm_args_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="#FF5252"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/jvm_args_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add argument" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Examples:  -XX:+UseG1GC   -Xss2M   -Dfile.encoding=UTF-8   --add-opens=java.base/java.lang=ALL-UNNAMED"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:typeface="monospace" />
    </LinearLayout>
</ScrollView>
