<?xml version="1.0" encoding="utf-8"?>
<!-- One JVM argument in the list of the JVM arguments dialog: on/off box, the argument, delete -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <CheckBox
        android:id="@+id/jvm_arg_enabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="Use this argument" />

    <EditText
        android:id="@+id/jvm_arg_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="-XX:+UseG1GC"
        android:imeOptions="actionDone"
        android:inputType="textNoSuggestions"
        android:maxLines="1"
        android:textSize="14sp"
        android:typeface="monospace" />

    <ImageButton
        android:id="@+id/jvm_arg_delete"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete this argument"
        android:src="@drawable/ic_menu_delete_forever"
        android:tint="?android:attr/textColorSecondary" />
</LinearLayout>
